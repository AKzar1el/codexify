  // Fleet V1: local isolated worktree bootstrap and scoped source/check lane.
  // Write operations are explicitly annotated and require normal host approval.
  if(config.enableScopedWorktreeActions===true){
    const enabled=["geo","godprompt","gsc","nofax","trendpulse","webvalidator"]
      .filter(name=>Object.hasOwn(config.projects,name)&&
        config.scopedWorktreePolicies?.[name]?.enabled===true);
    if(enabled.length){
      const project={type:"string",enum:enabled};
      const repo={type:"string",enum:["root","primary","companion"]};
      const hash={type:"string",pattern:"^[a-f0-9]{64}$"};
      const head={type:"string",pattern:"^[a-f0-9]{40}$"};
      const base={project,repository:repo,
        expected_journal_sha256:hash,expected_state_sha256:hash};
      const initSchema={...base,expected_main_sha:head};
      const initRequired=["project","repository","expected_main_sha",
        "expected_journal_sha256","expected_state_sha256"];
      const local={...base,worktree_id:{type:"string",pattern:"^[a-f0-9]{20}$"},
        expected_head:head,path:{type:"string",minLength:1,maxLength:220}};
      const localRequired=["project","repository","worktree_id","expected_head","path",
        "expected_journal_sha256","expected_state_sha256"];
      const runKey={type:"string",pattern:"^[A-Za-z0-9_.:+-]{8,160}$"};
      list.push(tool("plan_scoped_worktree",
        "Read-only plan for one clean local worktree, pinned to local main and exact journal/state SHA256; no effects.",
        initSchema,initRequired,readOnly));
      list.push(tool("create_scoped_worktree",
        "WRITE APPROVAL REQUIRED: Create one new local Git worktree with fresh branch and durable intent/result receipts. No remote fetch, push, merge, or historical journal changes.",
        initSchema,initRequired,
        {readOnlyHint:false,destructiveHint:true,idempotentHint:false,openWorldHint:false}));
      list.push(tool("preflight_worktree_action",
        "Read exact registered isolated worktree, Git HEAD, allowed source SHA and journal/state digests; no write authorization granted.",
        local,localRequired,readOnly));
      list.push(tool("apply_scoped_worktree_edit",
        "WRITE APPROVAL REQUIRED: Change exactly one allowlisted existing source file in a registered isolated worktree after SHA checks and durable intent. No canonical checkout or release effects.",
        {...local,run_key:runKey,expected_sha256:hash,
          find:{type:"string",minLength:1,maxLength:8192},
          replacement:{type:"string",maxLength:8192}},
        [...localRequired,"run_key","expected_sha256","find","replacement"],
        {readOnlyHint:false,destructiveHint:true,idempotentHint:false,openWorldHint:false}));
      list.push(tool("run_scoped_worktree_check",
        "WRITE APPROVAL REQUIRED: Run only project-approved bounded source-diff or GSC launcher check after a verified isolated source edit.",
        {...local,run_key:runKey,check_id:{type:"string",enum:["source-diff","launcher"]}},
        [...localRequired,"run_key","check_id"],
        {readOnlyHint:false,destructiveHint:true,idempotentHint:false,openWorldHint:false}));
    }
  }
