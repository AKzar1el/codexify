{
  "name": "@codexify/browser-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "description": "Single-window ChatGPT browser companion for Codexify agent chat",
  "scripts": {
    "build": "bun build src/main.ts --target=node --packages=external --outdir=dist",
    "typecheck": "bun x --no-install --bun tsc --noEmit",
    "test": "bun test ./tests",
    "install:chrome": "node scripts/install-chrome.cjs",
    "package": "node scripts/package.cjs",
    "smoke:package": "node scripts/smoke-package.cjs",
    "start": "bun run build && electron ."
  },
  "dependencies": {
    "@mixmark-io/domino": "2.2.0",
    "patchright": "1.63.0",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/turndown": "5.0.5",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "dev.codexify.browser-companion",
    "productName": "Codexify Browser Companion",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "LSBackgroundOnly": true
      }
    },
    "linux": {
      "category": "Development",
      "executableName": "codexify-browser-companion"
    },
    "win": {
      "executableName": "codexify-browser-companion"
    }
  }
}
