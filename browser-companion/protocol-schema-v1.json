{
  "protocolVersion": 1,
  "kind": "codexify-browser-companion",
  "fieldNaming": "camelCase",
  "strictObjects": true,
  "buildBinding": "<component-version>+protocol.<sha256-of-this-file>",
  "endpoints": [
    "GET /v1/health",
    "POST /v1/session/login",
    "POST /v1/session/capabilities",
    "POST /v1/window/reveal",
    "POST /v1/actions/execute",
    "POST /v1/actions/cancel",
    "GET /v1/actions/{actionId}",
    "GET /v1/actions/{actionId}/events?after={sequence}",
    "POST /v1/new-chat/capabilities",
    "POST /v1/account/plan",
    "POST /v1/connectors/refresh"
  ],
  "sessionStatuses": [
    "idle",
    "busy",
    "authentication_required",
    "unavailable"
  ],
  "actionStates": [
    "unpaired",
    "unverified",
    "queued",
    "navigating",
    "sending",
    "generating",
    "idle",
    "approval_required",
    "authentication_required",
    "rate_limited",
    "external_interference",
    "ambiguous",
    "stalled",
    "failed"
  ],
  "promptKinds": {
    "pair_verify": [
      "reference"
    ],
    "offline_chat": [
      "batchId",
      "messages"
    ],
    "offline_goal": [
      "goalRevision"
    ],
    "offline_combined": [
      "batchId",
      "messages",
      "goalRevision"
    ],
    "create_chat": [
      "continuationToken",
      "reference",
      "setupReference"
    ]
  },
  "fieldLimits": {
    "opaqueIdBytes": 256,
    "pairingReferenceBytes": 43,
    "connectorNameBytes": 128,
    "modelLabelBytes": 256,
    "effortLabelBytes": 256,
    "effortReasonBytes": 1024,
    "attentionMessageBytes": 65536
  },
  "eventTypes": [
    "queued",
    "navigating",
    "composer_ready",
    "model_verified",
    "connector_verified",
    "send_accepted",
    "conversation_created",
    "status_delta",
    "commentary_delta",
    "answer_delta",
    "submission_complete",
    "generation_complete",
    "approval_required",
    "authentication_required",
    "rate_limited",
    "external_interference",
    "ambiguous_send",
    "failed"
  ],
  "limits": {
    "descriptorBytes": 8192,
    "jsonBytes": 1048576,
    "eventStreamBytes": 16777216,
    "eventLineBytes": 131072,
    "deltaBytes": 65536,
    "finalAnswerBytes": 1048576,
    "promptBytes": 262144,
    "unreadMessages": 128,
    "chatGptUrlBytes": 4096
  },
  "modelSelection": {
    "model": "nullable opaque ID",
    "effort": "nullable opaque ID",
    "nullSelection": "use the conversation settings",
    "pairVerify": "null selection required",
    "expectedAccountFingerprint": "required opaque ID"
  },
  "newChat": {
    "continuationTokenBytes": 43,
    "setupReferenceMaxBytes": 4096,
    "destination": "configured ChatGPT project or top-level new chat",
    "completion": "confirmed new conversation URL after Send acceptance",
    "createdConversationEvent": "conversation_created"
  },
  "accountPlan": {
    "request": {
      "epoch": "opaque server-start identifier"
    },
    "response": {
      "label": "bounded display name",
      "sourceLabel": "billing plan name",
      "kind": [
        "free",
        "go",
        "pro",
        "unknown"
      ],
      "accountFingerprint": "opaque verified account identifier"
    },
    "cache": "one successful billing inspection per server epoch and account"
  },
  "connectorRefresh": {
    "request": {
      "name": "exact connector display name"
    },
    "completion": "observed refresh control busy/idle cycle and Allow all tools selected",
    "schemaVerified": false
  },
  "launchConfiguration": {
    "requestBlockList": "CODEXIFY_BROWSER_REQUEST_BLOCK_LIST: JSON array of RE2 URL patterns; verified browser-wide before navigation"
  }
}
